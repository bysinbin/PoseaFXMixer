[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
Provider=%ProviderName%
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer = 10/30/2026,1.0.0.1
CatalogFile=PoseaAudio.cat
PnpLockDown=1

[SourceDisksNames]
222=%DiskDescription%,"",222

[SourceDisksFiles]
PoseaAudio.sys=222

[Manufacturer]
%MfgName%=Posea,NTAMD64,NTx86,NTARM64

[Posea.NTAMD64]
%PoseaAudio.DeviceDesc%=PoseaAudio_Device,Root\PoseaAudio,*PoseaAudio

[Posea.NTx86]
%PoseaAudio.DeviceDesc%=PoseaAudio_Device,Root\PoseaAudio,*PoseaAudio

[Posea.NTARM64]
%PoseaAudio.DeviceDesc%=PoseaAudio_Device,Root\PoseaAudio,*PoseaAudio

[DestinationDirs]
PoseaAudio.CopyList=10,system32\drivers

[PoseaAudio.CopyList]
PoseaAudio.sys

[PoseaAudio.AddReg]
HKR,,AssociatedFilters,,"wdmaud,redbook"
HKR,,Driver,,PoseaAudio.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%PoseaAudio.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%PoseaAudio.DeviceDesc%
HKLM,%MediaCategories%\%PoseaAudio.NameGuid%,Name,,%PoseaAudio.Name%

[PoseaAudio_Device.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration, WDMAUDIO.Registration
CopyFiles=PoseaAudio.CopyList
AddReg=PoseaAudio.AddReg

[PoseaAudio_Device.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Wave%,PoseaAudio.I.Wave
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_Wave%,PoseaAudio.I.Wave
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Topology%,PoseaAudio.I.Topo

[PoseaAudio.I.Wave]
AddReg=PoseaAudio.I.Wave.AddReg

[PoseaAudio.I.Wave.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%PoseaAudio.Wave.szPname%

[PoseaAudio.I.Topo]
AddReg=PoseaAudio.I.Topo.AddReg

[PoseaAudio.I.Topo.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%PoseaAudio.Topo.szPname%

[PoseaAudio_Device.NT.Services]
AddService=PoseaAudio,0x00000002,PoseaAudio_Service_Inst

[PoseaAudio_Service_Inst]
DisplayName=%PoseaAudio.SvcDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%10%\system32\drivers\PoseaAudio.sys

[Strings]
ProviderName="Posea Technologies"
MfgName="Posea Technologies"
DiskDescription="Posea Audio Driver Disk"

PoseaAudio.Name="Posea Audio"
PoseaAudio.NameGuid="{7C23A9E4-1B5F-4E89-9A01-C34E89D2F1B4}"
PoseaAudio.DeviceDesc="Posea Audio Virtual Device"
PoseaAudio.SvcDesc="Posea Audio Engine Service"

PoseaAudio.Wave.szPname="Posea Audio Wave"
PoseaAudio.Topo.szPname="Posea Audio Topology"

Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"

KSNAME_Wave="Wave"
KSNAME_Topology="Topology"

MediaCategories="SYSTEM\CurrentControlSet\Control\MediaCategories"
